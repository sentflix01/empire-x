# Nodbusiness — Next.js Frontend Environment Variables
# Copy to .env.local

# Backend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Google OAuth: use the same active Web client ID as backend GOOGLE_CLIENT_ID.
# Configure this origin and /auth/google/callback on the OAuth client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# VAPID public key for push notifications
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=Bxxx...

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# App version (shown in Sentry releases)
NEXT_PUBLIC_APP_VERSION=1.0.0

# Public app URL (for SEO metadata)
NEXT_PUBLIC_APP_URL=https://nodbusiness.vercel.app
