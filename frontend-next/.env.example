# ============================================================
# Nodbusiness — Frontend Environment Variables (Next.js)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it's already in .gitignore.
# ============================================================

# ── Backend API ──────────────────────────────────────────────────────────────
# Local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Production (your Render backend URL)
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.onrender.com

# ── App URL ───────────────────────────────────────────────────────────────────
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Production (your Vercel frontend URL)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Web client
# Use a real active Web client ID, not the placeholder shown here. This must
# exactly match backend GOOGLE_CLIENT_ID. Add each app origin (for example
# http://localhost:3002 and https://nodbusiness.vercel.app) to Authorized
# JavaScript origins, and the matching /auth/google/callback URL to Authorized
# redirect URIs. NEXT_PUBLIC_* values are embedded into the frontend build.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys — use the PUBLISHABLE key (pk_...), NOT secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Sentry (optional) ────────────────────────────────────────────────────────
# https://sentry.io → New Project → Next.js → copy DSN
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# ── Feature Flags (optional overrides) ───────────────────────────────────────
# NEXT_PUBLIC_FF_CHAPA_PAYMENTS=true
