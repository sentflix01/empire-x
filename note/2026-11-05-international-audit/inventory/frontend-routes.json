  "public_paths_excerpt": "/**\n * lib/publicPaths.ts — Route visibility policy\n *\n * GUEST ACCESS POLICY:\n *   Guests can browse read-only discovery pages.\n *   Write actions (post, like, comment, follow) prompt sign-up.\n *   Builder pages remain auth-gated at all times.\n */\n\nconst PUBLIC_PATHS = new Set([\n  '/',\n  '/landing',\n  '/login',\n  '/auth/google/callback',\n  '/register',\n  '/forgot-password',\n  '/reset-password',\n  '/choose-account',\n  '/choose-mode',   // always accessible — handles own auth check via AuthContext\n  '/service-agreement',\n  '/not-found',\n  '/offline',       // served by the service worker when the network is down\n  '/sitemap',\n  '/robots',\n  '/onboarding',\n  // Guest-browsable discovery pages (read-only)\n  '/feed',\n  '/marketplace',\n  '/businesses',\n  '/showrooms',\n  '/explore',\n  '/nearby',\n]);\n\n// Builder pages — auth-gated at all times\nconst SHOWROOM_BUILDER_PAGES = new Set([\n  '/showroom/create',\n  '/showroom/templates',\n  '/showroom/samples',\n  '/showroom/studio',\n]);\n\n// Pages that require login even if prefixes would otherwise match\nconst AUTH_ONLY_PREFIXES = [\n  '/messages', '/notifications', '/settings', '/profile/edit',\n  '/account', '/wallet', '/orders', '/cart', '/bookmarks',\n  '/analytics', '/referral', '/coupons', '/friends',\n  '/scorecard',\n  // Product builder pages share the public /products/ prefix (audit F-012).\n  '/products/create', '/products/edit', '/products/scan',\n];\n\nexport function isPublicPath(pathname: string): boolean {\n  // Auth-only overrides everything\n  if (AUTH_ONLY_PREFIXES.some(p => pathname === p || pathname.startsWith(p + '/'))) return false;\n  // Builder pages always gated\n  if (SHOWROOM_BUILDER_PAGES.has(pathname)) return false;\n  // Exact match\n  if (PUBLIC_PATHS.has(pathname)) return true;\n  // Public prefixes\n  if (pathname.startsWith('/p/')) return true;\n  if (pathname.startsWith('/products/')) return true;\n  if (pathname.startsWith('/profile/')) return true;\n  if (pathname.startsWith('/showroom/')) return true;\n  if (pathname.startsWith('/showrooms/')) return true;\n  if (pathname.startsWith('/businesses/')) return true;\n  if (pathname.startsWith('/hashtag/')) return true;\n  // Private order links for guest checkout; access is the token itself.\n  if (pathname.startsWith('/order/')) return true;\n  return false;\n}\n\n/**\n * Top-level segments of real app pages that need sign-in. The edge proxy\n * sends guests to sign-in only under these; any other unknown path reaches\n * the not-found page with a 404 instead (audit F-036). A test checks that\n * every page in app/ is either public or listed here.\n */\nexport const SIGN_IN_ROOTS: ReadonlySet<string> = new Set([\n  'account', 'admin', 'analytics', 'bookmarks', 'business', 'cart', 'coupons',\n  'friends', 'messages', 'notifications', 'orders', 'privacy', 'products',\n  'profile', 'referral', 'scorecard', 'search', 'settings', 'showroom', 'wallet',\n]);\n\n/** True when a guest asking for this path should be sent to sign-in. */\nexport function requiresSignIn(pathname: st"
}
