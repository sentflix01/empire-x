# Dependencies
node_modules/
frontend/node_modules/
frontend-next/node_modules/
backend/node_modules/

# Environment files — NEVER commit these
.env
.env.local
frontend/.env
frontend/.env.local
frontend-next/.env
frontend-next/.env.local
backend/.env

# Build output
frontend/dist/
frontend/build/
frontend-next/.next/
frontend-next/out/
frontend-next/build/
frontend-next/*.tsbuildinfo

# Uploaded files (store on cloud storage in production)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
frontend-next/*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json

# Kiro / Codex temporary working directories
.codex-tmp*/
.kiro/tmp*/

# TypeScript incremental build caches
*.tsbuildinfo
backend/dist/
backend/backups/
