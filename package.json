{
  "name": "nodbusiness",
  "version": "1.0.0",
  "description": "Nodbusiness — Global Superapp. Monorepo root.",
  "private": true,
  "scripts": {
    "dev": "start \"backend\" cmd /k \"cd backend && npm run dev\" && start \"frontend-next\" cmd /k \"cd frontend-next && npm run dev\"",
    "install:all": "cd backend && npm install && cd ../frontend-next && npm install",
    "migrate": "cd backend && npm run migrate",
    "build": "cd frontend-next && npm run build",
    "lint": "cd frontend-next && npm run lint",
    "typecheck": "cd frontend-next && npx tsc --noEmit",
    "test": "cd backend && npm test",
    "production:sync": "node scripts/production-docs-sync.cjs",
    "production:sync:check": "node scripts/production-docs-sync.cjs --check"
  }
}
