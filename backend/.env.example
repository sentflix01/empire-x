# ============================================================
# Nodbusiness — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's already in .gitignore.
# ============================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Local development
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nodbusiness
# Docker Compose
# DATABASE_URL=postgresql://nodbusiness:nodbusiness_dev@postgres:5432/nodbusiness
# Production — Supabase pooler (for Render env var, port 6543, transaction mode):
# DATABASE_URL=postgresql://postgres.REF:[PASS]@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Production — Supabase direct (for migrations and pg_dump, port 5432):
# DATABASE_URL=postgresql://postgres.REF:[PASS]@db.REF.supabase.co:5432/postgres?sslmode=require&channel_binding=require
# Rule: use pooler URL (port 6543) in Render environment variables for the live app.
# Use direct URL (port 5432) in GitHub Secrets for migrations — DDL does not work through the pooler.
# TLS is enabled automatically in production and for recognized hosted DB URLs.
# For a private database root CA, set DB_SSL_CA_FILE to the PEM file downloaded
# from the provider dashboard. Certificate validation stays enabled.
# DB_SSL_CA_FILE=certs/prod-ca-2021.crt
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_CONNECTION_TIMEOUT_MS=15000

# Isolated Demo workspace (leave disabled until the dedicated Demo project is provisioned).
# Use a separate Supabase project and database for Demo. Keep these credentials
# separate from the Real Supabase project and its Storage bucket/key.
# DEMO_ENABLED=false
# DEMO_DATABASE_URL=postgresql://postgres.DEMO_PROJECT_REF:REPLACE_WITH_PASSWORD@POOLER_HOST:6543/postgres
# DATABASE_SCHEMA=public
# DEMO_DB_SCHEMA=public
# DEMO_SESSION_SECRET=<unique-long-random-secret-different-from-JWT_SECRET>
# DEMO_SUPABASE_URL=https://DEMO_PROJECT_REF.supabase.co
# DEMO_SUPABASE_STORAGE_KEY=sb_secret_<demo-project-secret>
# DEMO_SUPABASE_BUCKET=demo-uploads  # must exist with public access disabled
# DEMO_DB_SSL_CA_FILE=C:\\path\\to\\demo-database-root-ca.pem
# DEMO_DB_POOL_MAX=5

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_64_chars
# Refresh token lifetime (access token is always 15 min, hardcoded)
JWT_REFRESH_EXPIRES_IN=7d
# OTP salt — prevents DB-read rainbow-table attacks on stored OTP hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. App warns loudly if missing.
OTP_SALT=change_this_to_a_random_32_char_hex_string

# ── Redis (Phase 2 — add when ready) ──────────────────────────────────────────
# Local: redis://localhost:6379
# Docker Compose: redis://redis:6379
# Upstash (free): rediss://default:token@host.upstash.io:6380
# App works without Redis — falls back to no-op stub
# REDIS_URL=redis://localhost:6379
# Queue producers default off; when disabled, jobs use synchronous handlers.
ENABLE_QUEUE_PRODUCERS=false
# Queue workers default off; set true only on a dedicated worker service.
ENABLE_QUEUE_WORKERS=false
# Socket.IO Redis adapter: enable only when multiple backend instances share rooms.
ENABLE_SOCKET_REDIS_ADAPTER=false
# Startup cache warm makes 1 GET and (on a miss) 1 SETEX; leave off for demo.
ENABLE_STARTUP_CACHE_WARM=false

# ── Email ─────────────────────────────────────────────────────────────────────
# OPTION 1 (Recommended): Resend — https://resend.com — free, 3K/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Nodbusiness <onboarding@resend.dev>"
# Production with your own domain:
# EMAIL_FROM="Nodbusiness <noreply@nodbusiness.app>"

# OPTION 2: Gmail SMTP (backup)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client
# Set this to an active Google OAuth Web application client ID. It must exactly
# match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID. Configure each frontend origin
# and its /auth/google/callback URL in that OAuth client. Backend uses the ID to
# verify the audience on returned ID tokens.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Note: GOOGLE_CLIENT_SECRET is NOT used by this backend. ID token verification
# does not require the secret — only the client ID is needed for the audience check.

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Real-mode Stripe key. Leave blank to disable real checkout.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Demo-mode checkout reads only this test key and fails closed if it is missing.
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_MEWACHO_WEBHOOK_SECRET=whsec_...
# Currency charged by Stripe Checkout (default usd). If set to 'etb' and Stripe
# rejects it, checkout automatically falls back to USD using the rate below.
STRIPE_CURRENCY=usd
# ETB → USD conversion rate used for the fallback (and UI display)
STRIPE_ETB_TO_USD_RATE=0.008

# ── Chapa (Ethiopian payment gateway — ETB) ───────────────────────────────────
# Sign up: https://dashboard.chapa.co → Settings → API Keys
# Supports TeleBirr, CBE Birr, M-Pesa, Awash, and all major Ethiopian banks
CHAPA_SECRET_KEY=CHASECK_test_...
# Your API server URL (used for Chapa callback_url)
API_URL=http://localhost:3001

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Cloudflare R2 (required for production — replaces local disk)
# https://dash.cloudflare.com → R2 → Create bucket → Create API token
# NOTE: for free local development or a tiny closed beta, leave these values commented out.
# The app will then use local disk storage under `uploads/`.
# This is suitable for development and small pilot testing, but not for production.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=nodbusiness-uploads
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── AI (any one provider works) ───────────────────────────────────────────────
# AI_PROVIDER=openai          ← default (also supports: gemini, anthropic)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Web Push Notifications ────────────────────────────────────────────────────
# Generate once: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
# VAPID_PUBLIC_KEY=BxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxAA
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VAPID_EMAIL=mailto:admin@nodbusiness.app

# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# Create via @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry: https://sentry.io → New Project → Node.js → copy DSN
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# ── External API Integration ──────────────────────────────────────────────────
# AES-256-GCM key for encrypting external API credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Required in production.
# EXTERNAL_API_ENCRYPTION_KEY=your_64_hex_char_key_here

# ── Feature Flags (override defaults via env) ─────────────────────────────────
# Set any flag to true/false to override the default
# FF_PERSONALIZED_FEED=true
# FF_VIDEO_POSTS=true
FF_CHAPA_PAYMENTS=true
FF_STRIPE_PAYMENTS=true
# FF_COMMUNITY_GROUPS=true
# FF_LIVE_STREAMING=false
