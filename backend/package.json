{
  "name": "halehame-server",
  "version": "1.0.0",
  "description": "Halehame backend API server",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "node test/e2e.test.js",
    "test:unit": "jest --testPathPattern=test/.*\\.test\\.js --runInBand",
    "test:keploy:record": "keploy record -c 'node index.js'",
    "test:keploy:test": "keploy test -c 'node index.js'",
    "migrate": "node db/migrate-all.js",
    "seed": "node db/seed.js",
    "clean": "node db/cleanup-seed-data.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "test/e2e.test.js",
      "test/api.test.js",
      "test/presence.test.js",
      "test/realtime_chat.test.js",
      "test/profile_picture.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/helpers/setupTests.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@sentry/node": "^10.66.0",
    "bcryptjs": "2.4.3",
    "bullmq": "^5.79.2",
    "chapa-nodejs": "^2.1.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.2",
    "express-rate-limit": "7.2.0",
    "express-validator": "7.0.1",
    "google-auth-library": "9.6.3",
    "helmet": "7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "6.9.9",
    "pg": "8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.33.2",
    "socket.io": "^4.8.3",
    "stripe": "14.21.0",
    "uuid": "9.0.1",
    "web-push": "^3.6.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "axios": "^1.7.9",
    "fast-check": "^3.23.2",
    "jest": "29.7.0",
    "nodemon": "3.1.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.0"
  }
}
