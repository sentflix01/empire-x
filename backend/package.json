{
  "name": "nodbusiness-server",
  "version": "1.0.0",
  "description": "Nodbusiness backend API server",
  "type": "commonjs",
  "main": "index.js",
  "overrides": {
    "brace-expansion": ">=5.0.12",
    "engine.io": ">=6.6.11",
    "js-yaml": ">=4.3.1",
    "nanoid": ">=5.1.5",
    "uuid": "$uuid",
    "browserslist": ">=4.25.0",
    "proxy-addr": ">=2.0.8",
    "fast-copy": ">=4.0.5"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "build": "tsc --project tsconfig.json",
    "test": "node test/e2e.test.js",
    "test:unit": "jest --runInBand",
    "test:keploy:record": "keploy record -c 'node index.js'",
    "test:keploy:test": "keploy test -c 'node index.js'",
    "typecheck": "tsc --noEmit",
    "migrate": "node db/migrate-all.js",
    "migrate:demo": "node db/migrate-demo.js",
    "seed": "node db/seed.js",
    "seed:e2e": "node db/seed-e2e.js",
    "seed:demo": "node db/seed-demo.js",
    "seed:showrooms": "node db/seed-showrooms.js",
    "seed:patch-media": "node db/seed-patch-media.js",
    "seed:patch-business-feed": "node db/seed-patch-business-feed.js",
    "clean": "node db/cleanup-seed-data.js",
    "backup": "tsx scripts/backup-database.js",
    "backup:verify": "tsx scripts/verify-backup.js",
    "docs:api": "tsx scripts/generate-api-docs.js"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "allowJs": true,
            "resolveJsonModule": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "test/e2e.test.js",
      "test/api.test.js",
      "test/presence.test.js",
      "test/realtime_chat.test.js",
      "test/profile_picture.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/helpers/setupTests.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@sentry/node": "^10.75.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "3.0.3",
    "bullmq": "^6.3.7",
    "chapa-nodejs": "^2.1.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.4.5",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "7.3.2",
    "google-auth-library": "9.6.3",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "stripe": "23.0.0",
    "uuid": "14.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "axios": "^1.20.0",
    "fast-check": "^4.10.2",
    "jest": "30.5.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "6.0.3"
  }
}
