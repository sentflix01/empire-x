# ============================================================
# Nodbusiness — Backend Production Environment Example
# Copy values into your hosting provider (Render) or into a secure vault.
# DO NOT commit real secrets to git. This file is a template only.
# ============================================================

# Server
NODE_ENV=production
# PORT: Do NOT set this on Render — Render assigns the port dynamically via its
# own PORT env var. Setting PORT=3001 here causes Render to detect a custom port
# (3002 on the frontend) and route incorrectly. Leave PORT unset on Render so
# the app binds to whatever port Render provides.
# For local development only: PORT=3001
FRONTEND_URL=https://your-vercel-domain.com
LOG_LEVEL=info

# Database (PostgreSQL — Supabase)
# Supabase → Project Settings → Database → Connection pooling → Transaction → copy URI.
# Render runs a persistent backend: use Session pooler (port 5432), or direct
# connection when the host can reach the project's IPv6 endpoint.
# Do not commit the real URI; configure it in Render and GitHub Actions instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Real and Demo use separate Supabase projects and databases.
DATABASE_SCHEMA=public
# DEMO_ENABLED=false
# DEMO_DATABASE_URL=postgresql://postgres.DEMO_PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DEMO_DB_SCHEMA=public
# DEMO_SESSION_SECRET=<unique-random-secret-different-from-JWT_SECRET>
# DEMO_SUPABASE_URL=https://DEMO_PROJECT_REF.supabase.co
# DEMO_SUPABASE_STORAGE_KEY=sb_secret_<demo-project-secret>
# DEMO_SUPABASE_BUCKET=demo-uploads  # must exist with public=false
# Supabase root certificate is included at this path in the production image.
DB_SSL_CA_FILE=/app/certs/prod-ca-2021.crt
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_CONNECTION_TIMEOUT_MS=15000

# Auth
# Generate a 64-byte hex string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_string
JWT_EXPIRES_IN=7d

# Email (Resend recommended)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Nodbusiness <noreply@yourdomain.com>"

# Optional backup: Gmail SMTP if Resend is unavailable
# Use an App Password for Google accounts with 2FA enabled.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password

# Payments
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
CHAPA_SECRET_KEY=CHASECK_live_...

# Uploads (Cloudflare R2)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=nodbusiness-uploads
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Observability
SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# Redis (optional)
REDIS_URL=rediss://default:token@your-redis-provider:6380

# Google OAuth (if used)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# VAPID keys for push (generate once)
VAPID_PUBLIC_KEY=replace_with_vapid_public
VAPID_PRIVATE_KEY=replace_with_vapid_private
VAPID_EMAIL=mailto:admin@yourdomain.com

# External API encryption key (32 bytes hex, 64 chars)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTERNAL_API_ENCRYPTION_KEY=your_64_hex_char_key_here
