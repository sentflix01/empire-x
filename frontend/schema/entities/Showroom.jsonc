{
    "name": "Showroom",
    "type": "object",
    "properties": {
      "owner_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "business",
          "creative",
          "education",
          "events",
          "nonprofit",
          "personal",
          "media",
          "startup",
          "community"
        ]
      },
      "template": {
        "type": "string"
      },
      "sections": {
        "type": "string",
        "description": "JSON string of section blocks"
      },
      "cover_image": {
        "type": "string"
      },
      "logo_url": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "archived"
        ],
        "default": "draft"
      },
      "view_count": {
        "type": "number",
        "default": 0
      },
      "theme_color": {
        "type": "string",
        "default": "#D4AF37"
      }
    },
    "required": [
      "owner_id",
      "title",
      "category"
    ]
  }