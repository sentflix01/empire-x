{
    "name": "Product",
    "type": "object",
    "properties": {
      "seller_id": {
        "type": "string"
      },
      "business_id": {
        "type": "string",
        "description": "Reference to the Business entity this product belongs to"
      },
      "showroom_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "price": {
        "type": "number"
      },
      "currency": {
        "type": "string",
        "default": "ETB"
      },
      "stock": {
        "type": "number",
        "default": 0
      },
      "images": {
        "type": "string",
        "description": "JSON array of image URLs"
      },
      "category": {
        "type": "string"
      },
      "tags": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "sold_out",
          "draft"
        ],
        "default": "active"
      },
      "view_count": {
        "type": "number",
        "default": 0,
        "description": "Number of times this product has been viewed"
      }
    },
    "required": [
      "seller_id",
      "title",
      "price"
    ]
  }