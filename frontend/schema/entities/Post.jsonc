{
    "name": "Post",
    "type": "object",
    "properties": {
      "author_id": {
        "type": "string"
      },
      "author_name": {
        "type": "string"
      },
      "author_avatar": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "image_url": {
        "type": "string"
      },
      "post_type": {
        "type": "string",
        "enum": [
          "text",
          "image",
          "product",
          "task",
          "event"
        ],
        "default": "text"
      },
      "like_count": {
        "type": "number",
        "default": 0
      },
      "comment_count": {
        "type": "number",
        "default": 0
      },
      "share_count": {
        "type": "number",
        "default": 0
      }
    },
    "required": [
      "author_id",
      "content"
    ]
  }