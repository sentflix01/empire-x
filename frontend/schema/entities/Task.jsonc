{
    "name": "Task",
    "type": "object",
    "properties": {
      "requester_id": {
        "type": "string"
      },
      "agent_id": {
        "type": "string"
      },
      "task_type": {
        "type": "string",
        "enum": [
          "bill_payment",
          "document_pickup",
          "gov_form",
          "delivery",
          "queue_standing",
          "grocery",
          "other"
        ],
        "default": "other"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "offered_payment": {
        "type": "number"
      },
      "currency": {
        "type": "string",
        "default": "ETB"
      },
      "deadline": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "done",
          "cancelled"
        ],
        "default": "open"
      }
    },
    "required": [
      "requester_id",
      "title",
      "task_type",
      "offered_payment"
    ]
  }