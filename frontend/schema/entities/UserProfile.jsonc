{
    "name": "UserProfile",
    "type": "object",
    "properties": {
      "user_id": {
        "type": "string",
        "description": "Reference to auth user"
      },
      "display_name": {
        "type": "string"
      },
      "bio": {
        "type": "string"
      },
      "avatar_url": {
        "type": "string"
      },
      "cover_url": {
        "type": "string"
      },
      "profile_type": {
        "type": "string",
        "enum": [
          "personal",
          "business"
        ],
        "default": "personal"
      },
      "headline": {
        "type": "string",
        "description": "Professional headline like LinkedIn"
      },
      "location": {
        "type": "string"
      },
      "phone": {
        "type": "string"
      },
      "is_verified": {
        "type": "boolean",
        "default": false
      },
      "follower_count": {
        "type": "number",
        "default": 0
      },
      "following_count": {
        "type": "number",
        "default": 0
      },
      "has_business_profile": {
        "type": "boolean",
        "default": false
      },
      "business_name": {
        "type": "string"
      },
      "business_category": {
        "type": "string",
        "enum": [
          "shop",
          "course",
          "service",
          "restaurant",
          "portfolio",
          "event",
          "realestate",
          "health",
          "other"
        ]
      },
      "business_template": {
        "type": "string"
      },
      "business_description": {
        "type": "string"
      },
      "business_logo_url": {
        "type": "string"
      },
      "business_cover_url": {
        "type": "string"
      },
      "business_sections": {
        "type": "string",
        "description": "JSON string of website section blocks"
      },
      "business_theme_color": {
        "type": "string",
        "default": "#D4AF37"
      },
      "business_contact_email": {
        "type": "string"
      },
      "business_contact_phone": {
        "type": "string"
      },
      "business_address": {
        "type": "string"
      },
      "business_hours": {
        "type": "string",
        "description": "JSON string of operating hours"
      },
      "skills": {
        "type": "string",
        "description": "JSON array of skills for personal profile"
      },
      "experience": {
        "type": "string",
        "description": "JSON array of work experience"
      },
      "education": {
        "type": "string",
        "description": "JSON array of education"
      },
      "connection_count": {
        "type": "number",
        "default": 0
      },
      "ticker_text": {
        "type": "string",
        "description": "Custom scrolling ticker text displayed on feed posts"
      }
    },
    "required": [
      "user_id",
      "display_name",
      "profile_type"
    ]
  }